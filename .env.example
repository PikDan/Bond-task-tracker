# Env vars for running a single service directly (go run ./cmd/<service>)
# against the databases started by `docker compose up` (exposed on
# localhost:5433/5434/5435/5436). docker-compose.yml does NOT read this file --
# its own services already have these values wired in directly; this is
# only a reference for local, outside-of-Docker iteration on one service.

# project-service
DATABASE_URL=postgres://project:project@localhost:5433/project_db?sslmode=disable
PORT=8081
WORKSPACE_SERVICE_URL=http://localhost:8084

# task-service
# DATABASE_URL=postgres://task:task@localhost:5434/task_db?sslmode=disable
# PORT=8082
# PROJECT_SERVICE_URL=http://localhost:8081
# WORKSPACE_SERVICE_URL=http://localhost:8084

# timer-service
# DATABASE_URL=postgres://timer:timer@localhost:5435/timer_db?sslmode=disable
# PORT=8083
# TASK_SERVICE_URL=http://localhost:8082
# WORKSPACE_SERVICE_URL=http://localhost:8084
# PROJECT_SERVICE_URL=http://localhost:8081

# workspace-service
# DATABASE_URL=postgres://workspace:workspace@localhost:5436/workspace_db?sslmode=disable
# PORT=8084

# gateway
# PORT=8080
# PROJECT_SERVICE_URL=http://localhost:8081
# TASK_SERVICE_URL=http://localhost:8082
# TIMER_SERVICE_URL=http://localhost:8083
# WORKSPACE_SERVICE_URL=http://localhost:8084
