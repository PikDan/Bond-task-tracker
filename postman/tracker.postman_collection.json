            "body": {
              "mode": "raw",
              "raw": "{\n    \"project_id\": \"{{projectId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}"]
            }
          }
        },
        {
          "name": "Clear Task Project",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "X-User-Id", "value": "{{userId}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"project_id\": \"\"\n}",
              "options": { "raw": { "language": "json" } },
              "description": "IMPORTANT: send an empty string, not JSON null, to clear project_id. A `null` value is indistinguishable from omitting the key entirely (both decode to \"don't touch\" on the server) — only an empty string is recognized as \"clear it.\""
            },
            "url": {
              "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks", "{{taskId}}"]
            }
          }
        },
        {
          "name": "Create Second Task (for reassignment testing)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
